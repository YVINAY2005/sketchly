# Sketchly Environment Configuration

# Server Port
PORT=3001

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local mongod)
# If unreachable, the server gracefully defaults to in-memory storage without crashing.
MONGODB_URI=mongodb://127.0.0.1:27017/sketchly

# Client Origin for CORS (e.g. your Vercel frontend URL in production)
CLIENT_URL=http://localhost:5173

