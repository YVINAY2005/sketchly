# Server Environment Variables (Example)

# Port to listen on
PORT=3001

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local mongod)
# If unreachable, the server gracefully defaults to in-memory mode without crashing.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.rebqiah.mongodb.net/sketchly?retryWrites=true&w=majority

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

